# Local SQLite database used by Prisma.
DATABASE_URL="file:./dev.db"

# Authentication secrets are supplied by the developer at runtime.
# Each must contain at least 32 bytes. Do not use these comments as secret values.
JWT_ACCESS_SECRET=access_secret123
JWT_REFRESH_SECRET=refresh_secret123
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
